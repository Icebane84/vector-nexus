; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ashen Oath"
run/main_scene="res://scenes/world/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

_Director="*res://scripts/globals/CORE.Kernel.Director.gd"
Log="*res://scripts/globals/CORE.Log.GlobalLogger.gd"
_GameEvents="*res://scripts/globals/CORE.Kernel.GameEvents.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-context-exporter-b4998954c7e67ca9a631d95993a686a8c9997f66/addons/godot_context_exporter/plugin.cfg", "res://addons/phoenix_architect/plugin.cfg", "res://addons/b3rdpscam/plugin.cfg")

[importer_defaults]

animation_library={
"_subresources": {
"meshes": {
"Model_Mesh": {
"generate/lightmap_uv": 0,
"generate/lods": 0,
"generate/shadow_meshes": 0,
"lods/normal_merge_angle": 20.0,
"save_to_file/enabled": true,
"save_to_file/fallback_path": "res://assets/Models/ModelMesh/Model_Mesh.res",
"save_to_file/path": "uid://cwlg5wfo8g0k7"
},
"Model_Mesh_001": {
"generate/lightmap_uv": 0,
"generate/lods": 0,
"generate/shadow_meshes": 0,
"lods/normal_merge_angle": 20.0,
"save_to_file/enabled": true,
"save_to_file/fallback_path": "res://assets/Models/ModelMesh/Model_Mesh_001.res",
"save_to_file/path": "uid://buca4jhar5wru"
}
}
},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"gltf/embedded_image_handling": 1,
"gltf/naming_version": 1,
"import_script/path": "",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_type": "Node3D",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

